# Mock mode is used when either value is missing.
# Keep this key server-side. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Set this to a vision-capable model available to your OpenAI project.
# No model name is hard-coded because availability may vary by account.
OPENAI_VISION_MODEL=

# Claude documentation assistant. Both values are required for Claude mode.
# Keep this key server-side. Never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Set this to a Claude model available to your Anthropic account.
# No model name is hard-coded because availability may vary by account.
ANTHROPIC_MODEL=

# Included by the platform starter for its health check.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
